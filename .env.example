# Supabase project (Project Settings → API). Leave empty to run in browser-only demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: shows WhatsApp buttons. International format without "+", e.g. 919876543210
VITE_WHATSAPP_NUMBER=
# Optional: shown in the footer
VITE_CONTACT_EMAIL=
# Your website address, e.g. https://sanskrutijewels.com. Needed for shared product links
# from the iOS/Android apps; the website falls back to its own address.
VITE_SITE_URL=
