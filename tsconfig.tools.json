{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "e2e",
    "tests",
    "scripts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.db.config.ts",
    "vite.config.ts",
    "capacitor.config.ts",
    "src/vite-env.d.ts"
  ]
}
